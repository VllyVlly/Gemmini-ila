	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 vcdparser
.PHONY : vcdparser

# fast build rule for target.
vcdparser/fast:
	$(MAKE) $(MAKESILENT) -f ILAng/extern/vcd-parser/src/CMakeFiles/vcdparser.dir/build.make ILAng/extern/vcd-parser/src/CMakeFiles/vcdparser.dir/build
.PHONY : vcdparser/fast

