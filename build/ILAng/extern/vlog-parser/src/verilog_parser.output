Grammar

    0 $accept: grammar_begin $end

    1 grammar_begin: library_text
    2              | config_declaration
    3              | source_text
    4              | ε

    5 text_macro_usage: MACRO_IDENTIFIER list_of_actual_arguments
    6                 | MACRO_IDENTIFIER

    7 list_of_actual_arguments: actual_argument
    8                         | list_of_actual_arguments COMMA actual_argument

    9 actual_argument: expression

   10 library_text: library_descriptions
   11             | library_text library_descriptions

   12 library_descriptions: library_declaration
   13                     | include_statement
   14                     | config_declaration

   15 library_declaration: KW_LIBRARY library_identifier file_path_specs SEMICOLON
   16                    | KW_LIBRARY library_identifier file_path_specs KW_INCDIR file_path_specs SEMICOLON

   17 file_path_specs: file_path_spec
   18                | file_path_specs COMMA file_path_spec

   19 file_path_spec: file_path

   20 file_path: string

   21 include_statement: KW_INCLUDE file_path_spec SEMICOLON

   22 config_declaration: KW_CONFIG config_identifier SEMICOLON design_statement config_rule_statement_os KW_ENDCONFIG

   23 design_statement: KW_DESIGN lib_cell_identifier_os SEMICOLON

   24 lib_cell_identifier_os: ε
   25                       | cell_identifier
   26                       | library_identifier DOT cell_identifier
   27                       | lib_cell_identifier_os cell_identifier
   28                       | lib_cell_identifier_os library_identifier DOT cell_identifier

   29 config_rule_statement_os: ε
   30                         | config_rule_statement
   31                         | config_rule_statement_os config_rule_statement

   32 config_rule_statement: KW_DEFAULT liblist_clause
   33                      | inst_clause liblist_clause
   34                      | inst_clause use_clause
   35                      | cell_clause liblist_clause
   36                      | cell_clause use_clause

   37 inst_clause: KW_INSTANCE inst_name

   38 inst_name: topmodule_identifier instance_identifier_os

   39 instance_identifier_os: ε
   40                       | DOT instance_identifier
   41                       | instance_identifier_os DOT instance_identifier

   42 cell_clause: KW_CELL cell_identifier
   43            | KW_CELL library_identifier DOT cell_identifier

   44 liblist_clause: KW_LIBLIST library_identifier_os

   45 library_identifier_os: ε
   46                      | library_identifier
   47                      | library_identifier_os library_identifier

   48 use_clause: KW_USE library_identifier DOT cell_identifier COLON KW_CONFIG
   49           | KW_USE library_identifier DOT cell_identifier
   50           | KW_USE cell_identifier COLON KW_CONFIG
   51           | KW_USE cell_identifier

   52 source_text: description
   53            | source_text description

   54 description: module_declaration
   55            | udp_declaration

   56 module_declaration: attribute_instances module_keyword module_identifier module_parameter_port_list list_of_port_declarations SEMICOLON non_port_module_item_os KW_ENDMODULE
   57                   | attribute_instances module_keyword module_identifier module_parameter_port_list list_of_ports SEMICOLON module_item_os KW_ENDMODULE

   58 module_keyword: KW_MODULE
   59               | KW_MACROMODULE

   60 module_parameter_port_list: ε
   61                           | HASH OPEN_BRACKET module_params CLOSE_BRACKET

   62 module_params: parameter_declaration
   63              | module_params COMMA parameter_declaration

   64 list_of_ports: ε
   65              | OPEN_BRACKET ports CLOSE_BRACKET

   66 list_of_port_declarations: OPEN_BRACKET CLOSE_BRACKET
   67                          | OPEN_BRACKET port_declarations CLOSE_BRACKET

   68 port_declarations: port_declarations COMMA port_dir port_declaration_l
   69                  | port_declarations COMMA identifier_csv port_dir port_declaration_l
   70                  | port_dir port_declaration_l

   71 port_declaration_l: net_type_o signed_o range_o port_identifier
   72                   | signed_o range_o port_identifier
   73                   | KW_REG signed_o range_o port_identifier eq_const_exp_o
   74                   | output_variable_type_o port_identifier
   75                   | output_variable_type port_identifier eq_const_exp_o

   76 identifier_csv: ε
   77               | identifier
   78               | COMMA identifier identifier_csv

   79 port_dir: attribute_instances KW_OUTPUT
   80         | attribute_instances KW_INPUT
   81         | attribute_instances KW_INOUT

   82 port_declaration: inout_declaration
   83                 | input_declaration
   84                 | output_declaration

   85 ports: ε
   86      | ports COMMA port
   87      | port

   88 port: port_expression
   89     | DOT port_identifier OPEN_BRACKET port_expression CLOSE_BRACKET

   90 port_expression: port_reference
   91                | port_expression COMMA port_reference

   92 port_reference: port_identifier
   93               | port_identifier OPEN_SQ_BRACKET constant_expression CLOSE_SQ_BRACKET
   94               | port_identifier OPEN_SQ_BRACKET range_expression CLOSE_SQ_BRACKET

   95 module_item_os: ε
   96               | module_item
   97               | module_item_os module_item

   98 non_port_module_item_os: ε
   99                        | non_port_module_item
  100                        | non_port_module_item_os non_port_module_item

  101 module_item: module_or_generate_item
  102            | port_declaration SEMICOLON
  103            | attribute_instances generated_instantiation
  104            | attribute_instances local_parameter_declaration
  105            | attribute_instances parameter_declaration SEMICOLON
  106            | attribute_instances specify_block
  107            | attribute_instances specparam_declaration

  108 module_or_generate_item: attribute_instances module_or_generate_item_declaration
  109                        | attribute_instances parameter_override
  110                        | attribute_instances continuous_assign
  111                        | attribute_instances gate_instantiation
  112                        | attribute_instances udp_instantiation
  113                        | attribute_instances module_instantiation
  114                        | attribute_instances initial_construct
  115                        | attribute_instances always_construct

  116 module_or_generate_item_declaration: net_declaration
  117                                    | reg_declaration
  118                                    | integer_declaration
  119                                    | real_declaration
  120                                    | time_declaration
  121                                    | realtime_declaration
  122                                    | event_declaration
  123                                    | genvar_declaration
  124                                    | task_declaration
  125                                    | function_declaration

  126 non_port_module_item: attribute_instances generated_instantiation
  127                     | attribute_instances local_parameter_declaration
  128                     | attribute_instances module_or_generate_item
  129                     | attribute_instances parameter_declaration SEMICOLON
  130                     | attribute_instances specify_block
  131                     | attribute_instances specparam_declaration

  132 parameter_override: KW_DEFPARAM list_of_param_assignments SEMICOLON

  133 signed_o: KW_SIGNED
  134         | ε

  135 range_o: range
  136        | ε

  137 local_parameter_declaration: KW_LOCALPARAM signed_o range_o list_of_param_assignments SEMICOLON
  138                            | KW_LOCALPARAM KW_INTEGER list_of_param_assignments SEMICOLON
  139                            | KW_LOCALPARAM KW_REAL list_of_param_assignments SEMICOLON
  140                            | KW_LOCALPARAM KW_REALTIME list_of_param_assignments SEMICOLON
  141                            | KW_LOCALPARAM KW_TIME list_of_param_assignments SEMICOLON

  142 parameter_declaration: KW_PARAMETER signed_o range_o list_of_param_assignments
  143                      | KW_PARAMETER KW_INTEGER list_of_param_assignments
  144                      | KW_PARAMETER KW_REAL list_of_param_assignments
  145                      | KW_PARAMETER KW_REALTIME list_of_param_assignments
  146                      | KW_PARAMETER KW_TIME list_of_param_assignments

  147 specparam_declaration: KW_SPECPARAM range_o list_of_specparam_assignments SEMICOLON

  148 net_type_o: net_type
  149           | ε

  150 reg_o: KW_REG
  151      | ε

  152 inout_declaration: KW_INOUT net_type_o signed_o range_o list_of_port_identifiers

  153 input_declaration: KW_INPUT net_type_o signed_o range_o list_of_port_identifiers

  154 output_declaration: KW_OUTPUT net_type_o signed_o range_o list_of_port_identifiers
  155                   | KW_OUTPUT reg_o signed_o range_o list_of_port_identifiers
  156                   | KW_OUTPUT output_variable_type_o list_of_port_identifiers
  157                   | KW_OUTPUT output_variable_type list_of_variable_port_identifiers
  158                   | KW_OUTPUT KW_REG signed_o range_o list_of_variable_port_identifiers

  159 event_declaration: KW_EVENT list_of_event_identifiers SEMICOLON

  160 genvar_declaration: KW_GENVAR list_of_genvar_identifiers SEMICOLON

  161 integer_declaration: KW_INTEGER list_of_variable_identifiers SEMICOLON

  162 time_declaration: KW_TIME list_of_variable_identifiers SEMICOLON

  163 real_declaration: KW_REAL list_of_real_identifiers SEMICOLON

  164 realtime_declaration: KW_REALTIME list_of_real_identifiers SEMICOLON

  165 delay3_o: delay3
  166         | ε

  167 drive_strength_o: OPEN_BRACKET drive_strength
  168                 | ε

  169 net_declaration: net_type net_dec_p_ds
  170                | net_type OPEN_BRACKET drive_strength net_dec_p_ds
  171                | KW_TRIREG net_dec_p_ds
  172                | KW_TRIREG OPEN_BRACKET drive_strength net_dec_p_ds
  173                | KW_TRIREG charge_strength net_dec_p_ds

  174 net_dec_p_ds: KW_VECTORED net_dec_p_vs
  175             | KW_SCALARED net_dec_p_vs
  176             | net_dec_p_vs

  177 net_dec_p_vs: KW_SIGNED net_dec_p_si
  178             | net_dec_p_si

  179 net_dec_p_si: range net_dec_p_range
  180             | net_dec_p_range

  181 net_dec_p_range: delay3 net_dec_p_delay
  182                | net_dec_p_delay

  183 net_dec_p_delay: list_of_net_identifiers SEMICOLON
  184                | list_of_net_decl_assignments SEMICOLON

  185 reg_declaration: KW_REG KW_SIGNED reg_dec_p_signed
  186                | KW_REG reg_dec_p_signed

  187 reg_dec_p_signed: range reg_dec_p_range
  188                 | reg_dec_p_range

  189 reg_dec_p_range: list_of_variable_identifiers SEMICOLON

  190 net_type: KW_SUPPLY0
  191         | KW_SUPPLY1
  192         | KW_TRI
  193         | KW_TRIAND
  194         | KW_TRIOR
  195         | KW_WIRE
  196         | KW_WAND
  197         | KW_WOR

  198 output_variable_type_o: output_variable_type
  199                       | ε

  200 output_variable_type: KW_INTEGER
  201                     | KW_TIME

  202 real_type: real_identifier
  203          | real_identifier EQ constant_expression
  204          | real_identifier dimension dimensions

  205 dimensions: dimension
  206           | dimensions dimension
  207           | ε

  208 variable_type: variable_identifier
  209              | variable_identifier EQ constant_expression
  210              | variable_identifier dimension dimensions

  211 drive_strength: strength0 COMMA strength1 CLOSE_BRACKET
  212               | strength1 COMMA strength0 CLOSE_BRACKET
  213               | strength0 COMMA KW_HIGHZ1 CLOSE_BRACKET
  214               | strength1 COMMA KW_HIGHZ0 CLOSE_BRACKET
  215               | KW_HIGHZ0 COMMA strength1 CLOSE_BRACKET
  216               | KW_HIGHZ1 COMMA strength0 CLOSE_BRACKET

  217 strength0: KW_SUPPLY0
  218          | KW_STRONG0
  219          | KW_PULL0
  220          | KW_WEAK0

  221 strength1: KW_SUPPLY1
  222          | KW_STRONG1
  223          | KW_PULL1
  224          | KW_WEAK1

  225 charge_strength: OPEN_BRACKET KW_SMALL CLOSE_BRACKET
  226                | OPEN_BRACKET KW_MEDIUM CLOSE_BRACKET
  227                | OPEN_BRACKET KW_LARGE CLOSE_BRACKET

  228 delay3: HASH delay_value
  229       | HASH OPEN_BRACKET delay_value CLOSE_BRACKET
  230       | HASH OPEN_BRACKET delay_value COMMA delay_value CLOSE_BRACKET
  231       | HASH OPEN_BRACKET delay_value COMMA delay_value COMMA delay_value CB
  232       | ε

  233 delay2: HASH delay_value
  234       | HASH OPEN_BRACKET delay_value CLOSE_BRACKET
  235       | HASH OPEN_BRACKET delay_value COMMA delay_value CLOSE_BRACKET
  236       | ε

  237 delay_value: unsigned_number
  238            | parameter_identifier
  239            | specparam_identifier
  240            | mintypmax_expression

  241 dimensions_o: dimensions
  242             | ε

  243 list_of_event_identifiers: event_identifier dimensions_o
  244                          | list_of_event_identifiers COMMA event_identifier dimensions_o

  245 list_of_genvar_identifiers: genvar_identifier
  246                           | list_of_genvar_identifiers COMMA genvar_identifier

  247 list_of_net_decl_assignments: net_decl_assignment
  248                             | list_of_net_decl_assignments COMMA net_decl_assignment

  249 list_of_net_identifiers: net_identifier dimensions_o
  250                        | list_of_net_identifiers COMMA net_identifier dimensions_o

  251 list_of_param_assignments: param_assignment
  252                          | list_of_param_assignments COMMA param_assignment
  253                          | list_of_param_assignments COMMA KW_PARAMETER param_assignment

  254 single_port_identifier: port_identifier

  255 list_of_port_identifiers: port_identifier
  256                         | port_identifier OPEN_SQ_BRACKET constant_expression CLOSE_SQ_BRACKET
  257                         | list_of_port_identifiers COMMA port_identifier
  258                         | list_of_port_identifiers COMMA port_identifier OPEN_SQ_BRACKET constant_expression CLOSE_SQ_BRACKET

  259 list_of_real_identifiers: real_type
  260                         | list_of_real_identifiers COMMA real_type

